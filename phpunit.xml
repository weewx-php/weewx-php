<?xml version="1.0" encoding="UTF-8"?>
<!--
    The unit tests. Run in the container (tests/docker/compose.yml), where the
    repository is mounted read-only: every path a test writes to comes from
    WEEWX_PHP_TMP, and the cache lives there too.

    enforceTimeLimit needs the pcntl extension, which the test image has. A
    test that hangs then fails and names itself instead of the run being
    killed from outside.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory="/tmp/phpunit-cache"
         colors="true"
         enforceTimeLimit="true"
         defaultTimeLimit="60"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerDeprecations="true">
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="WEEWX_PHP_TMP" value="/tmp"/>
    </php>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
